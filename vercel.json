{
  "redirects": [
    { "source": "/resena", "destination": "/resenas", "permanent": false },
    { "source": "/rese", "destination": "/resenas", "permanent": false },
    { "source": "/comprar.html", "destination": "/catalogo.html", "permanent": true },
    { "source": "/comprar", "destination": "/catalogo.html", "permanent": true },
    { "source": "/psi.html", "destination": "/", "permanent": true },
    { "source": "/psi", "destination": "/", "permanent": true },
    { "source": "/encuesta", "destination": "/", "permanent": true },
    { "source": "/encuesta/", "destination": "/", "permanent": true },
    { "source": "/encuesta/:path*", "destination": "/", "permanent": true },
    {
      "source": "/propiedad.html",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.+)" }],
      "destination": "/propiedades/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/llms.txt", "destination": "/api/llms" },
    { "source": "/alquiler-amoblado-buenos-aires", "destination": "/api/guia?lang=es" },
    { "source": "/en/furnished-apartments-buenos-aires", "destination": "/api/guia?lang=en" },
    { "source": "/alquilar-sin-garantia-buenos-aires", "destination": "/api/guia?lang=es&tema=sin-garantia" },
    { "source": "/en/rent-without-guarantor-buenos-aires", "destination": "/api/guia?lang=en&tema=sin-garantia" },
    { "source": "/alquiler-por-meses-buenos-aires", "destination": "/api/guia?lang=es&tema=por-meses" },
    { "source": "/en/monthly-rentals-buenos-aires", "destination": "/api/guia?lang=en&tema=por-meses" },
    { "source": "/alquiler-amoblado-:zona", "destination": "/api/guia?lang=es&zona=:zona" },
    { "source": "/en/furnished-apartments-:zona", "destination": "/api/guia?lang=en&zona=:zona" },
    { "source": "/julian", "destination": "/julian.html" },
    { "source": "/resenas", "destination": "/resenas.html" },
    { "source": "/reseñas", "destination": "/resenas.html" },
    { "source": "/rese%C3%B1as", "destination": "/resenas.html" },
    { "source": "/propiedades/:slug", "destination": "/api/og-propiedad?slug=:slug" },
    {
      "source": "/propiedad.html",
      "has": [{ "type": "query", "key": "slug" }],
      "destination": "/api/og-propiedad"
    }
  ],
  "crons": [
    { "path": "/api/indexnow", "schedule": "0 12 * * *" }
  ],
  "functions": {
    "api/embellecer.js": { "maxDuration": 150 }
  }
}
