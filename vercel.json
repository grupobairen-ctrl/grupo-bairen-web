{
  "redirects": [
    {
      "source": "/propiedad.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.+)"
        }
      ],
      "destination": "/propiedades/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/julian",
      "destination": "/julian.html"
    },
    {
      "source": "/propiedades/:slug",
      "destination": "/api/og-propiedad?slug=:slug"
    },
    {
      "source": "/propiedad.html",
      "has": [
        {
          "type": "query",
          "key": "slug"
        }
      ],
      "destination": "/api/og-propiedad"
    },
    {
      "source": "/portal/_rewrite-probe",
      "destination": "/portal/probe.txt"
    },
    {
      "source": "/portal/propiedad-:id",
      "destination": "/portal/propiedad.html"
    },
    {
      "source": "/portal/:tipo(departamentos|pisos|ph|casas|propiedades)-:op(venta|alquiler-mediano-plazo|alquiler)-:zona",
      "destination": "/portal/buscar.html"
    },
    {
      "source": "/portal/:page(publicar|ingresar|panel|curacion|legales|publicadores|buscar|importar|emprendimientos|publicar-aviso)",
      "destination": "/portal/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/portal/_rewrite-probe",
      "headers": [
        {
          "key": "x-bp-rewrite",
          "value": "1"
        }
      ]
    },
    {
      "source": "/portal/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/portal/(.*)\\.(png|jpg|jpeg|webp|avif|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/portal/:path*\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/portal/data/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/portal/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://nmrjyyrhwjroonrppnka.supabase.co; media-src 'self' blob:; connect-src 'self' https://nmrjyyrhwjroonrppnka.supabase.co; frame-src https://www.youtube-nocookie.com https://iframe.mediadelivery.net; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
