{
  "version": "5.0",
  "screens": [
    {
      "id": "ZONAS",
      "title": "Tus zonas",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "CheckboxGroup",
            "name": "zonas",
            "label": "¿En qué barrio/s buscás?",
            "required": true,
            "data-source": [
              { "id": "z_palermo", "title": "Palermo" },
              { "id": "z_recoleta", "title": "Recoleta" },
              { "id": "z_belgrano", "title": "Belgrano" },
              { "id": "z_nunez", "title": "Núñez" },
              { "id": "z_colegiales", "title": "Colegiales" },
              { "id": "z_villacrespo", "title": "Villa Crespo" },
              { "id": "z_almagro", "title": "Almagro" },
              { "id": "z_centro", "title": "Centro" },
              { "id": "z_retiro", "title": "Retiro" },
              { "id": "z_madero", "title": "Puerto Madero" },
              { "id": "z_norte", "title": "Zona Norte" }
            ]
          },
          {
            "type": "Footer",
            "label": "Continuar",
            "on-click-action": {
              "name": "complete",
              "payload": { "zonas": "${form.zonas}" }
            }
          }
        ]
      }
    }
  ]
}
