        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "slug",
              "value": "=eq.{{ $json.slug }}"
            },
            {
              "name": "select",
              "value": "imagenes(url,orden)"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_D0YwiSL5Hm3GyOSx2r1lug_ZV7v46_n"
            },
            {
              "name": "Authorization",
              "value": "Bearer sb_publishable_D0YwiSL5Hm3GyOSx2r1lug_ZV7v46_n"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -360,
        320
      ],
      "id": "fotos-get-0001",
      "name": "Traer fotos de Supabase"
    },
    {
      "parameters": {
        "jsCode": "const res = $input.all();\nlet imgs = [];\nfor (const it of res) {\n  const j = it.json;\n  if (Array.isArray(j)) { for (const p of j) imgs.push(...(p.imagenes || [])); }\n  else if (j.imagenes) { imgs.push(...j.imagenes); }\n  else if (j.url) { imgs.push(j); }\n}\nimgs.sort((a, b) => (a.orden ?? 0) - (b.orden ?? 0));\nconst jid = String($('Inicio').first().json.remoteJid || '');\nconst number = jid.split('@')[0];\nreturn imgs.map((im) => ({ json: { url: im.url, number } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        320
      ],
      "id": "fotos-prep-0001",
      "name": "Preparar URLs"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        120,
        320
      ],
      "id": "fotos-loop-0001",
      "name": "Una por una"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://evolution:8080/message/sendMedia/bairen",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "bairen-evolution-key-cambiala"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.number }}\",\n  \"mediatype\": \"image\",\n  \"media\": \"{{ $json.url }}\",\n  \"caption\": \"\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
