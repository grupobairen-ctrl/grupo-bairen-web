# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como .env y completá los valores.
# ─────────────────────────────────────────────────────────────────────────────

# --- Claude (el cerebro) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Evolution API (WhatsApp no oficial) ---
# URL donde corre Evolution (en el VPS, normalmente http://evolution:8080 dentro de docker,
# o http://localhost:8080 si el bot corre fuera de docker).
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=cambiá-esto-por-una-clave-larga
# Nombre de la "instancia" que vas a crear en Evolution (el número del bot).
EVOLUTION_INSTANCE=bairen

# --- Tiziana (a quién le avisamos cada lead) ---
# Número en formato internacional sin signos: 549 + área sin 0 + número. Ej Bs As: 5491122334455
TIZIANA_WHATSAPP=5491100000000

# --- Google Calendar (agenda de Bairen) ---
# ID del calendario de Bairen (en Google Calendar > Configuración del calendario > "ID de calendario").
GOOGLE_CALENDAR_ID=bairen@group.calendar.google.com
# Credenciales de la cuenta de servicio (service account) de Google, como JSON en una línea.
# Compartí el calendario de Bairen con el email de esa service account, con permiso de "hacer cambios".
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Supabase (mismo proyecto que el web) ---
SUPABASE_URL=https://nmrjyyrhwjroonrppnka.supabase.co
SUPABASE_ANON_KEY=sb_publishable_D0YwiSL5Hm3GyOSx2r1lug_ZV7v46_n

# --- Franja de visitas (opcional, default 16 a 19) ---
VISITA_DESDE=16
VISITA_HASTA=19

# --- Puerto del bot ---
PORT=3200
